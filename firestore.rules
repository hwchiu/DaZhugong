rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function memberPath(groupId, memberId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(memberId);
    }

    function tokenPath(groupId, tokenId) {
      return /databases/$(database)/documents/groups/$(groupId)/tokens/$(tokenId);
    }

    function reportPath(groupId, tokenId) {
      return /databases/$(database)/documents/groups/$(groupId)/reports/$(tokenId);
    }

    function memberIsActive(groupId, memberId) {
      return exists(memberPath(groupId, memberId))
        && get(memberPath(groupId, memberId)).data.active == true;
    }

    function memberExists(groupId, memberId) {
      return exists(memberPath(groupId, memberId));
    }

    function isMember(groupId, memberId) {
      return request.auth != null
        && memberIsActive(groupId, memberId)
        && get(memberPath(groupId, memberId)).data.authUid == request.auth.uid;
    }

    function hasExactTokenFields(data) {
      return (
        data.keys().hasAll([
            'targetId',
            'reporterId',
            'status',
            'createdAt',
            'confirmedAt',
            'resolvedAt'
          ])
          && data.keys().hasOnly([
            'targetId',
            'reporterId',
            'status',
            'createdAt',
            'confirmedAt',
            'resolvedAt'
          ])
      ) || (
        data.keys().hasAll([
            'targetId',
            'reporterId',
            'status',
            'reason',
            'createdAt',
            'confirmedAt',
            'resolvedAt'
          ])
          && data.keys().hasOnly([
            'targetId',
            'reporterId',
            'status',
            'reason',
            'createdAt',
            'confirmedAt',
            'resolvedAt'
          ])
      );
    }

    function hasExactReportFields(data) {
      return (
        data.keys().hasAll(['targetId', 'reporterId', 'timestamp'])
        && data.keys().hasOnly(['targetId', 'reporterId', 'timestamp'])
      ) || (
        data.keys().hasAll(['targetId', 'reporterId', 'reason', 'timestamp'])
        && data.keys().hasOnly(['targetId', 'reporterId', 'reason', 'timestamp'])
      ) || (
        // 新流程(reportAndConfirmToken/reportSpecialToken)寫入的report一律帶完整
        // 的tokenType/displayTokenCount/tokenValue/source四個欄位；舊流程(舊版
        // pending/confirm、還沒上這次改動之前的資料)完全不會有這四個欄位，
        // 兩種形狀分開列，互不影響、也不強迫舊資料補欄位。
        data.keys().hasAll([
            'targetId', 'reporterId', 'reason', 'timestamp',
            'tokenType', 'displayTokenCount', 'tokenValue', 'source'
          ])
          && data.keys().hasOnly([
            'targetId', 'reporterId', 'reason', 'timestamp',
            'tokenType', 'displayTokenCount', 'tokenValue', 'source'
          ])
      );
    }

    function validReasonValue(reason) {
      return reason is string && reason.size() > 0 && reason.size() <= 200;
    }

    function validTokenCreate(groupId) {
      return hasExactTokenFields(request.resource.data)
        && request.resource.data.targetId is string
        && request.resource.data.reporterId is string
        && request.resource.data.targetId != request.resource.data.reporterId
        && memberIsActive(groupId, request.resource.data.targetId)
        && isMember(groupId, request.resource.data.reporterId)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.confirmedAt == null
        && request.resource.data.resolvedAt == null;
    }

    function immutableTokenIdentity() {
      return request.resource.data.targetId == resource.data.targetId
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function matchingReportAfter(groupId, tokenId) {
      return !exists(reportPath(groupId, tokenId))
        && existsAfter(reportPath(groupId, tokenId))
        && hasExactReportFields(getAfter(reportPath(groupId, tokenId)).data)
        && getAfter(reportPath(groupId, tokenId)).data.targetId == resource.data.targetId
        && getAfter(reportPath(groupId, tokenId)).data.reporterId == resource.data.reporterId
        && getAfter(reportPath(groupId, tokenId)).data.timestamp == request.time;
    }

    function validTokenUpdate(groupId, tokenId) {
      return hasExactTokenFields(request.resource.data)
        && resource.data.status == 'pending'
        && memberExists(groupId, resource.data.reporterId)
        && memberIsActive(groupId, resource.data.targetId)
        && isMember(groupId, resource.data.targetId)
        && immutableTokenIdentity()
        && (
          (
            request.resource.data.status == 'rejected'
            && request.resource.data.confirmedAt == null
            && request.resource.data.resolvedAt == request.time
            && !existsAfter(reportPath(groupId, tokenId))
          )
          ||
          (
            request.resource.data.status == 'confirmed'
            && request.resource.data.confirmedAt == request.time
            && request.resource.data.resolvedAt == request.time
            && matchingReportAfter(groupId, tokenId)
          )
        );
    }

    function validReportCreate(groupId, tokenId) {
      return hasExactReportFields(request.resource.data)
        && request.resource.data.timestamp == request.time
        && exists(tokenPath(groupId, tokenId))
        && existsAfter(tokenPath(groupId, tokenId))
        && get(tokenPath(groupId, tokenId)).data.status == 'pending'
        && getAfter(tokenPath(groupId, tokenId)).data.status == 'confirmed'
        && getAfter(tokenPath(groupId, tokenId)).data.targetId
          == get(tokenPath(groupId, tokenId)).data.targetId
        && getAfter(tokenPath(groupId, tokenId)).data.reporterId
          == get(tokenPath(groupId, tokenId)).data.reporterId
        && getAfter(tokenPath(groupId, tokenId)).data.createdAt
          == get(tokenPath(groupId, tokenId)).data.createdAt
        && request.resource.data.targetId == getAfter(tokenPath(groupId, tokenId)).data.targetId
        && request.resource.data.reporterId == getAfter(tokenPath(groupId, tokenId)).data.reporterId
        && memberExists(groupId, request.resource.data.reporterId)
        && memberIsActive(groupId, request.resource.data.targetId)
        && isMember(groupId, request.resource.data.targetId);
    }

    // ---- 新流程：報告人直接選人+填原因，一次寫入就是「已確認」，不再經過對方確認 ----
    // 跟舊流程最關鍵的差異：isMember() 檢查的是 reporterId(自己)，不是 targetId(對方)。
    // 舊流程是「對方確認才算數」，新流程是「自己選+自己送出就算數」，這是刻意的行為改變，
    // 不是疏忽——這一行如果寫成isMember(...targetId)，就等於還是舊的信任模型。
    function matchingDirectReportAfter(groupId, tokenId) {
      return !exists(reportPath(groupId, tokenId))
        && existsAfter(reportPath(groupId, tokenId))
        && hasExactReportFields(getAfter(reportPath(groupId, tokenId)).data)
        && getAfter(reportPath(groupId, tokenId)).data.targetId == request.resource.data.targetId
        && getAfter(reportPath(groupId, tokenId)).data.reporterId == request.resource.data.reporterId
        && getAfter(reportPath(groupId, tokenId)).data.timestamp == request.time
        && getAfter(reportPath(groupId, tokenId)).data.reason == request.resource.data.reason;
    }

    function validDirectConfirmedTokenCreate(groupId, tokenId) {
      return hasExactTokenFields(request.resource.data)
        && request.resource.data.keys().hasAll(['reason'])
        && validReasonValue(request.resource.data.reason)
        && request.resource.data.targetId is string
        && request.resource.data.reporterId is string
        && request.resource.data.targetId != request.resource.data.reporterId
        && memberIsActive(groupId, request.resource.data.targetId)
        && isMember(groupId, request.resource.data.reporterId)
        && request.resource.data.status == 'confirmed'
        && request.resource.data.createdAt == request.time
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.resolvedAt == request.time
        && matchingDirectReportAfter(groupId, tokenId);
    }

    function validDirectReportCreate(groupId, tokenId) {
      return hasExactReportFields(request.resource.data)
        && request.resource.data.keys().hasAll(['reason'])
        && validReasonValue(request.resource.data.reason)
        && request.resource.data.timestamp == request.time
        && !exists(tokenPath(groupId, tokenId))
        && existsAfter(tokenPath(groupId, tokenId))
        && getAfter(tokenPath(groupId, tokenId)).data.status == 'confirmed'
        && getAfter(tokenPath(groupId, tokenId)).data.targetId == request.resource.data.targetId
        && getAfter(tokenPath(groupId, tokenId)).data.reporterId == request.resource.data.reporterId
        && getAfter(tokenPath(groupId, tokenId)).data.reason == request.resource.data.reason
        && memberExists(groupId, request.resource.data.reporterId)
        && memberIsActive(groupId, request.resource.data.targetId)
        && isMember(groupId, request.resource.data.reporterId)
        // 這條路徑寫入的report如果帶了新的四個Token欄位(reportAndConfirmToken這次
        // 改動之後一律會帶)，值必須固定是「一般Token」的常數，不能是任意值——
        // 防止有人繞過reportSpecialToken()、直接假裝走一般流程但夾帶tokenValue=5
        // 之類的竄改。沒有帶這四個欄位的舊呼叫方式(理論上不會再發生，但規則本身
        // 不要求一定要有這四個欄位，維持hasExactReportFields原本容許的彈性)。
        && (
          !request.resource.data.keys().hasAny(['tokenType'])
          || (
            request.resource.data.tokenType == 'NORMAL'
            && request.resource.data.displayTokenCount == 1
            && request.resource.data.tokenValue == 1
            && request.resource.data.source == 'NORMAL_FLOW'
          )
        );
    }

    // ---- 特殊Token(隱藏摩擦豬公彩蛋)：spec見「隱藏特殊Token系統開發規格」----
    // 這裡是AC19「Server驗證tokenValue，不接受前端自行傳任意倍率」的實際防線：
    // tokenType/displayTokenCount/tokenValue/source四個欄位的值全部寫死在規則裡，
    // 不是拿request.resource.data裡的值直接信任比對，就算tokenService.js那邊的
    // 呼叫程式碼以後被改壞、或有人直接用Firestore SDK繞過前端UI呼叫，這裡都會擋下來。
    function validSpecialTokenReportCreate(groupId, tokenId) {
      return hasExactReportFields(request.resource.data)
        && request.resource.data.keys().hasAll([
          'reason', 'tokenType', 'displayTokenCount', 'tokenValue', 'source'
        ])
        && validReasonValue(request.resource.data.reason)
        && request.resource.data.timestamp == request.time
        && request.resource.data.targetId is string
        && request.resource.data.reporterId is string
        && request.resource.data.targetId != request.resource.data.reporterId
        && request.resource.data.tokenType == 'SPECIAL_5X'
        && request.resource.data.displayTokenCount == 1
        && request.resource.data.tokenValue == 5
        && request.resource.data.source == 'PIG_RUB_EASTER_EGG'
        && memberExists(groupId, request.resource.data.reporterId)
        && memberIsActive(groupId, request.resource.data.targetId)
        && isMember(groupId, request.resource.data.reporterId);
    }

    // 每日召喚限制的標記文件：markerId由client端用「groupId+reporterId+日期字串」
    // 決定性(deterministic)算出來，同一人同一天永遠算出同一個ID。這裡只允許
    // 「建立」，不允許之後的update——所以只要今天已經有一份，Firestore會把第二次
    // 寫入同一個ID判定成「這個文件已存在，這是一次update」，而下面沒有宣告
    // allow update，就自動被拒絕，達到「一人一天只能成功寫入一次」的效果，
    // 不需要規則語言自己去解析request.time算出今天日期字串來比對。
    //
    // 已知的取捨(誠實記錄，不是完美方案)：這份規則只確保「reporterId欄位」對應
    // 目前登入者本人(靠isMember)，不會反過來驗證「markerId的字串格式」真的是用
    // 這個reporterId+正確日期算出來的——一個直接用Firestore SDK而非透過這個app
    // 前端呼叫的使用者，理論上可以每次自訂一個不同的markerId來繞過自己的每日
    // 限制。這是「軟性防濫用」的取捨，不影響AC19要求的tokenValue帳務完整性
    // (那一個防線在validSpecialTokenReportCreate，是硬性、獨立驗證的)。
    function validSpecialTokenSummonMarkerCreate(groupId, markerId) {
      return request.resource.data.keys().hasAll(['reporterId', 'reportId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['reporterId', 'reportId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.reporterId is string
        && request.resource.data.reportId is string
        && isMember(groupId, request.resource.data.reporterId);
    }

    // ---- 申訴功能：撤銷不合理或記錯的紀錄 ----
    // 資料模型：在既有report文件「額外」加appealedAt/appealConfirmedBy兩個欄位，
    // 沒被申訴過的文件完全不會有這兩個欄位，不影響原本的建立規則(validReportCreate等)。

    // 核心欄位(targetId/reporterId/timestamp/reason/tokenType/displayTokenCount/
    // tokenValue/source)在申訴流程中一律不能被更動，這裡把這個檢查獨立出來，
    // file跟confirm兩種update都要用同一套。新增的四個Token欄位比照reason的做法：
    // 「這份文件本來有沒有這個欄位」跟「更新後還是不是同樣的狀態+同樣的值」都要一致，
    // 避免有人假借申訴流程夾帶偷改tokenValue這種帳務欄位。
    function reportFieldUnchangedOnAppealUpdate(field) {
      return resource.data.keys().hasAny([field])
        ? request.resource.data[field] == resource.data[field]
        : !request.resource.data.keys().hasAny([field]);
    }

    function reportIdentityUnchangedOnAppealUpdate() {
      return request.resource.data.targetId == resource.data.targetId
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.timestamp == resource.data.timestamp
        && reportFieldUnchangedOnAppealUpdate('reason')
        && reportFieldUnchangedOnAppealUpdate('tokenType')
        && reportFieldUnchangedOnAppealUpdate('displayTokenCount')
        && reportFieldUnchangedOnAppealUpdate('tokenValue')
        && reportFieldUnchangedOnAppealUpdate('source');
    }

    // 提出申訴：只有這筆紀錄的當事人(targetId本人)可以做，而且必須是還沒申訴過
    // (沒有appealedAt欄位，或者欄位是null)的紀錄——不能對同一筆紀錄重複申訴。
    function validAppealFileUpdate(groupId, tokenId) {
      return (!resource.data.keys().hasAny(['appealedAt']) || resource.data.appealedAt == null)
        && reportIdentityUnchangedOnAppealUpdate()
        && request.resource.data.appealedAt == request.time
        && request.resource.data.appealConfirmedBy == []
        && request.resource.data.keys().hasAll(['appealedAt', 'appealConfirmedBy'])
        && isMember(groupId, resource.data.targetId)
        && request.auth.uid == get(memberPath(groupId, resource.data.targetId)).data.authUid;
    }

    // 申訴需要幾人確認才會刪除紀錄——跟前端tokenService.js的
    // APPEAL_CONFIRMATIONS_REQUIRED常數保持同一個數字(3)。規則語言沒辦法跨檔案
    // 共用常數，所以只在這個檔案裡把魔術數字集中成一個函式，validAppealConfirmUpdate
    // 與validAppealDelete都呼叫這裡，不要各自寫死3。
    function appealConfirmationsRequired() {
      return 3;
    }

    // 確認申訴：陣列只能一次增加剛好一筆，而且新增的那個人必須是「目前送出這個請求的
    // 已登入成員」本人(不能幫別人蓋確認)、不能是這筆紀錄的當事人(不能自己確認自己的申訴)、
    // 也不能是已經確認過的人(不能重複確認衝票數)。用陣列切片比對「除了最後一個新加的
    // 元素之外，前面都跟原本一樣」，確保不是整個陣列被任意替換掉。
    //
    // before.size() < appealConfirmationsRequired()這一條(2026-09-07新增)：一旦文件
    // 已經達到門檻人數，只能走delete、不能再繼續update疊加確認人數——搭配
    // tokenService.js把「新增確認」跟「達標後刪除」拆成兩次分開送出的Firestore寫入
    // (見該檔案confirmAppeal的說明)，這裡確保就算兩個人的確認請求幾乎同時抵達、
    // 也不會有第4筆確認被塞進一份「其實已經該被刪除」的文件裡。
    function validAppealConfirmUpdate(groupId, tokenId) {
      let before = resource.data.appealConfirmedBy;
      let after = request.resource.data.appealConfirmedBy;
      let newMemberId = after[before.size()];
      return resource.data.keys().hasAll(['appealedAt', 'appealConfirmedBy'])
        && resource.data.appealedAt != null
        && reportIdentityUnchangedOnAppealUpdate()
        && request.resource.data.appealedAt == resource.data.appealedAt
        && request.resource.data.keys() == resource.data.keys()
        && before.size() < appealConfirmationsRequired()
        && after.size() == before.size() + 1
        // 注意：故意不用陣列切片(after[0:before.size()])比對前綴，因為當before
        // 為空陣列時，Firestore模擬器的空切片(start==end==0)會觸發模擬器本身的
        // index-out-of-bound錯誤(而非單純回傳false)，導致規則評估直接失敗、
        // 部署測試連帶掛掉。改用concat()重組陣列比對，語意相同但不會踩到這個
        // 空切片的實作問題。這個修正來自Copilot實際跑emulator測試抓到的問題
        // (我自己沒有能力在這個環境驗證真正的Firestore emulator行為)。
        && after == before.concat([newMemberId])
        && newMemberId != resource.data.targetId
        && !before.hasAny([newMemberId])
        && isMember(groupId, newMemberId)
        && request.auth.uid == get(memberPath(groupId, newMemberId)).data.authUid;
    }

    // 刪除：只有在「這筆紀錄已經有appealConfirmationsRequired()人以上確認申訴」的
    // 狀態下才允許刪除——用resource.data(刪除前、已經存在的文件狀態)檢查，
    // 不是用request.resource(刪除沒有這個東西)，確保不是隨便就能刪掉一筆紀錄。
    //
    // 這條規則能通過的前提是：湊滿門檻人數的那一筆確認，必須先透過
    // validAppealConfirmUpdate「真的commit」到文件裡，delete才會在下一次、
    // 獨立送出的Firestore寫入裡看到resource.data.appealConfirmedBy.size()達標
    // ——這正是tokenService.js把confirmAppeal拆成兩個階段(Phase 1 update、
    // Phase 2 delete)的原因，也是這次修正的bug（第3次確認一律permission-denied）
    // 的根本解法。同一個transaction裡先update再delete「不會」讓這裡通過，
    // 因為resource.data在單一transaction內看到的一律是transaction開始前、
    // 伺服器上已經commit的狀態，不會反映同一個transaction裡稍早的寫入。
    function validAppealDelete(groupId, tokenId) {
      return resource.data.keys().hasAll(['appealConfirmedBy'])
        && resource.data.appealConfirmedBy.size() >= appealConfirmationsRequired();
    }

    match /groups/{groupId} {
      allow read: if true;
      allow write: if false;

      match /members/{memberId} {
        allow read: if true;
        allow write: if false;
      }

      match /memberAuth/{memberId} {
        allow read, write: if false;
      }

      match /tokens/{tokenId} {
        allow read: if true;
        allow create: if validTokenCreate(groupId) || validDirectConfirmedTokenCreate(groupId, tokenId);
        allow update: if validTokenUpdate(groupId, tokenId);
        allow delete: if false;
      }

      match /reports/{tokenId} {
        allow read: if true;
        allow create: if validReportCreate(groupId, tokenId)
          || validDirectReportCreate(groupId, tokenId)
          || validSpecialTokenReportCreate(groupId, tokenId);
        allow update: if validAppealFileUpdate(groupId, tokenId) || validAppealConfirmUpdate(groupId, tokenId);
        allow delete: if validAppealDelete(groupId, tokenId);
      }

      // 每日召喚限制標記：read開放(前端可能想顯示「今天已經召喚過了」之類的狀態)，
      // 只能create、不能update/delete——見validSpecialTokenSummonMarkerCreate的說明。
      match /specialTokenSummons/{markerId} {
        allow read: if true;
        allow create: if validSpecialTokenSummonMarkerCreate(groupId, markerId);
        allow update, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
