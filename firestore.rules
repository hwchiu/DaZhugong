rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId} {
      allow read: if true;
      allow write: if false;

      match /members/{memberId} {
        allow read: if true;
        allow write: if false;
      }

      match /tokens/{tokenId} {
        allow read: if true;
        allow write: if false;
      }

      match /reports/{reportId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
